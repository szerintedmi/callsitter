# Copy to .env (Bun loads it automatically).

# Local server (the tunnel points here)
PORT=8787
BIND_HOST=127.0.0.1
# Operator API for deploys (drain/resume/status), always on 127.0.0.1 (scripts/control.ts)
CONTROL_PORT=8788

# Public hostname Telnyx reaches (Cloudflare tunnel, no trailing slash)
PUBLIC_WS_BASE=wss://hooks.example.com

# Telnyx: API key, webhook public key (Mission Control → Keys & Credentials → Public Key)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=

OPENAI_API_KEY=
TYPESAFE_API_KEY=

# OpenAI SIP (optional; README → OpenAI SIP). `bun scripts/setup-sip.ts` fills these in.
# Project the carrier dials (sip:proj_…@sip.api.openai.com), and the live.transport.incoming
# webhook's signing secret. SIP is off unless both are set.
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
# Telnyx telephony credential the browser SIP test (/test-call → SIP) logs in with, and its
# credential connection.
TELNYX_SIP_CREDENTIAL_ID=
TELNYX_SIP_CONNECTION_ID=

# Signs media WebSocket URLs. Generate with: openssl rand -base64 48
MEDIA_TOKEN_SECRET=

# Telegram to the owner (optional; README → Setup): a status message per call, and steering the
# call by replying. The bot's token from @BotFather and the owner's (numeric) chat id with it.
# Set both, or neither to turn them off. Dev needs its own bot: only one process can poll one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The first name callers may ask for (used in the voice agent and Luna prompts). Optional.
OWNER_NAME=
# Languages the voice agent speaks. Default: any common language; limit it in free text, e.g.
# "English and French".
AGENT_LANGUAGES=

DATA_DIR=./data
CONFIG_DIR=./config

# Admin UI protection. access: only via Cloudflare Access on ADMIN_HOST (the app verifies the Access JWT).
# none: loopback only (http://127.0.0.1:8787/), for offline/local dev.
ADMIN_AUTH=access
ADMIN_HOST=admin.example.com
# Team domain (Zero Trust > Settings), e.g. myteam.cloudflareaccess.com.
# AUD: Zero Trust > Access controls > Applications > Configure > Additional settings > Application Audience (AUD) Tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
