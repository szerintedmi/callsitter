# Copy to .env (Bun loads it automatically).

# Local server (the tunnel points here)
PORT=8787
BIND_HOST=127.0.0.1

# Public hostname Telnyx reaches (Cloudflare tunnel, no trailing slash)
PUBLIC_WS_BASE=wss://hooks.example.com

# Telnyx: API key, webhook public key (Mission Control → Keys & Credentials → Public Key),
# SMS sender (+447 number, or alphanumeric sender ID with a messaging profile). Optional:
# leave empty to disable SMS to the owner.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_SMS_FROM=
TELNYX_MESSAGING_PROFILE_ID=

OPENAI_API_KEY=
TYPESAFE_API_KEY=

# OpenAI SIP (optional; README → OpenAI SIP). `bun scripts/setup-sip.ts` fills these in.
# Project the carrier dials (sip:proj_…@sip.api.openai.com), and the live.transport.incoming
# webhook's signing secret. SIP is off unless both are set.
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
# Telnyx telephony credential the browser SIP test (/ui/test-call → SIP) logs in with.
TELNYX_SIP_CREDENTIAL_ID=

# Signs media WebSocket URLs. Generate with: openssl rand -base64 48
MEDIA_TOKEN_SECRET=

# The phone's owner: SMS notifications go to OWNER_NUMBER (E.164); OWNER_NAME is the first
# name callers may ask for (used in the voice agent and Luna prompts). Both optional.
OWNER_NUMBER=
OWNER_NAME=
# Languages the voice agent speaks ({agent_languages} in live.yaml), e.g. "English and Hungarian".
# It answers in the caller's language if it's one of these, otherwise English. Default: English.
AGENT_LANGUAGES=

DATA_DIR=./data
CONFIG_DIR=./config

# UI protection. access: only via Cloudflare Access on UI_HOST (the app verifies the Access JWT).
# none: loopback only (http://127.0.0.1:8787/ui), for offline/local dev.
UI_AUTH=access
UI_HOST=ui.example.com
# Team domain (Zero Trust > Settings), e.g. myteam.cloudflareaccess.com.
# AUD: Zero Trust > Access controls > Applications > Configure > Additional settings > Application Audience (AUD) Tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
