#!/usr/bin/env bash
# Deploys and operates CallSitter on the VPS (docs/deploy.md). Installed to /usr/local/bin by
# bootstrap.sh and run as root: by the GitHub Actions deploy key (through callsitter-deploy-ssh and
# sudo), by you over SSH, and by the nightly backup and maintenance timers.
#
#   deploy <IMAGE_REPO>@sha256:<digest>   pull (registry token on stdin, optional), drain calls,
#                                         back up the DB, replace the container, wait for healthy;
#                                         rolls back to the previous release if it isn't
#   rollback                              redeploy the previous release (its image is kept locally)
#   status                                current release, container state, active calls
#   drain | resume                        stop / restart taking calls (e.g. around host maintenance)
#   backup                                nightly SQLite copy to /var/lib/callsitter/backups
#   maintain [--check]                    nightly: upgrade cloudflared and Docker, and reboot if the
#                                         OS asks for it, once no call is live (--check: report only)
#   maintain --after-boot                 at boot: report a maintenance reboot to Telegram
#
# Exit 75: calls didn't end within DRAIN_WAIT seconds (maintain: MAINTAIN_WAIT); nothing changed,
# try again later.
set -euo pipefail
umask 077

CONF=/etc/callsitter/deploy.conf
# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"
: "${IMAGE_REPO:?set IMAGE_REPO in $CONF}"
GHCR_USER=${GHCR_USER:-github-actions}
DRAIN_WAIT=${DRAIN_WAIT:-1260}
KEEP_RELEASES=${KEEP_RELEASES:-5}
KEEP_BACKUPS=${KEEP_BACKUPS:-10}
MAINTAIN_WAIT=${MAINTAIN_WAIT:-7200}
# Upgraded by `maintain`, between calls; unattended-upgrades only installs Debian security updates.
HOST_PKGS=(cloudflared docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin)

DIR=/opt/callsitter
RELEASES=$DIR/releases        # image refs, oldest first; the last line is the current release
COMPOSES=$DIR/compose.d       # each release's compose.yaml, by digest
DRAINED=""                            # set while the old container is draining
BACKUPS=/var/lib/callsitter/backups   # /data/backups in the container
FAILED_LOGS=$DIR/failed               # logs of releases that never became healthy (root-only)
REBOOT_MARK=$DIR/maintain-reboot      # what a maintenance reboot followed, for the boot report
APP_UID=1000                          # the image's `bun` user, which writes /data

log() { printf '[%s] %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }
die() { log "error: $*" >&2; exit 1; }
compose() { docker compose --project-directory "$DIR" -f "$DIR/compose.yaml" "$@"; }
running() { [[ -f $DIR/compose.yaml && -n $(compose ps -q --status running callsitter 2>/dev/null) ]]; }
control() { compose exec -T callsitter bun scripts/control.ts "$@"; }
digest_of() { local d=${1##*@sha256:}; printf '%s' "${d:0:16}"; }
current() { if [[ -s $RELEASES ]]; then tail -n1 "$RELEASES"; fi; }
# The newest release before the current one (skipping repeats from earlier rollbacks).
previous() { if [[ -s $RELEASES ]]; then tac "$RELEASES" | awk '!seen[$0]++' | sed -n 2p; fi; }
revision() { docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$1" 2>/dev/null || true; }

try_lock() {
  exec 9>/run/callsitter-deploy.lock
  flock -n 9
}
lock() { try_lock || die "another callsitter-deploy is running"; }

# Points compose.yaml and .env at a release; the compose file comes from the release's image.
activate() {
  local ref=$1 saved
  saved="$COMPOSES/$(digest_of "$ref").yaml"
  if [[ ! -s $saved ]]; then
    local cid
    cid=$(docker create "$ref")
    docker cp "$cid:/app/deploy/compose.yaml" "$saved.tmp" >/dev/null
    docker rm "$cid" >/dev/null
    mv "$saved.tmp" "$saved"
  fi
  install -m 0644 "$saved" "$DIR/compose.yaml"
  printf 'CALLSITTER_IMAGE=%s\n' "$ref" >"$DIR/.env"
}

pull() {
  local ref=$1 token=$2 cfg
  if docker image inspect "$ref" >/dev/null 2>&1; then return; fi
  # Throwaway Docker config: the short-lived GITHUB_TOKEN is never stored on the VPS.
  cfg=$(mktemp -d)
  if [[ -n $token ]]; then
    # Output only on failure: on success it's just the "stored unencrypted" warning about $cfg,
    # which is deleted after the pull (and the token expires with the job).
    local out
    out=$(printf '%s' "$token" | DOCKER_CONFIG=$cfg docker login ghcr.io -u "$GHCR_USER" --password-stdin 2>&1) ||
      { rm -rf "$cfg"; die "registry login failed: $out"; }
  fi
  DOCKER_CONFIG=$cfg docker pull -q "$ref" >/dev/null || { rm -rf "$cfg"; die "pull failed: $ref"; }
  rm -rf "$cfg"
}

prune() {
  local keep img
  keep=$(tac "$RELEASES" | awk '!seen[$0]++' | head -n "$KEEP_RELEASES")
  tail -n 100 "$RELEASES" >"$RELEASES.tmp" && mv "$RELEASES.tmp" "$RELEASES"
  while read -r img; do
    [[ -z $img ]] || grep -qxF "$img" <<<"$keep" || docker rmi "$img" >/dev/null 2>&1 || true
  done < <(docker image ls --digests --format '{{.Repository}}@{{.Digest}}' "$IMAGE_REPO")
  find "$BACKUPS" -maxdepth 1 -name 'pre-deploy-*.db' -printf '%T@ %p\n' 2>/dev/null |
    sort -rn | tail -n +"$((KEEP_BACKUPS + 1))" | cut -d' ' -f2- | xargs -r rm -f --
}

cmd_deploy() {
  local ref=${1:-} token=""
  [[ $ref =~ ^${IMAGE_REPO}@sha256:[0-9a-f]{64}$ ]] || die "usage: deploy ${IMAGE_REPO}@sha256:<digest>"
  [[ -t 0 ]] || token=$(head -c 4096 || true)
  lock
  mkdir -p "$COMPOSES"
  install -d -o "$APP_UID" -g "$APP_UID" -m 0750 "$BACKUPS"
  local prev
  prev=$(current)
  [[ $ref == "$prev" ]] && running && { log "already running $ref"; cmd_status; return; }

  log "pulling $ref"
  pull "$ref" "$token"
  log "revision $(revision "$ref")"

  if running; then
    log "draining: new calls are rejected until the new release is up"
    local rc=0
    control drain --wait "$DRAIN_WAIT" --ttl $((DRAIN_WAIT + 300)) || rc=$?
    if ((rc == 75)); then log "deploy deferred: calls still active after ${DRAIN_WAIT}s"; exit 75; fi
    ((rc == 0)) || die "drain failed (exit $rc)"
    DRAINED=1
    # If anything below fails before the switch, take calls again rather than wait for the TTL.
    trap 'if [[ -n $DRAINED ]]; then control resume >/dev/null 2>&1 || true; fi' EXIT
    control_backup "pre-deploy-$(date -u +%Y%m%dT%H%M%SZ)-$(digest_of "${prev:-none}").db" || die "pre-deploy backup failed"
  fi

  activate "$ref"
  log "starting the new release"
  if compose up -d --wait --wait-timeout 180 callsitter; then
    DRAINED=""
    echo "$ref" >>"$RELEASES"
    prune
    log "deployed $(revision "$ref") ($ref)"
    cmd_status
    return
  fi

  # Saved on the VPS rather than printed: GitHub Actions logs are public. The rollback replaces the
  # container, so `docker logs` won't have them afterwards.
  local failed
  failed="$FAILED_LOGS/$(date -u +%Y%m%dT%H%M%SZ)-$(digest_of "$ref").log"
  mkdir -p "$FAILED_LOGS"
  compose logs --no-log-prefix --tail 200 callsitter >"$failed" 2>&1 || true
  log "the new release didn't become healthy; its logs: sudo cat $failed"
  if [[ -n $prev ]]; then
    log "rolling back to $prev"
    activate "$prev"
    compose up -d --wait --wait-timeout 180 callsitter || log "rollback didn't become healthy either"
    DRAINED=""
  fi
  exit 1
}

control_backup() {
  running || { log "not running: backup skipped"; return 0; }
  compose exec -T callsitter bun scripts/backup-db.ts "/data/backups/$1"
}

cmd_rollback() {
  local prev
  prev=$(previous)
  [[ -n $prev ]] || die "no previous release recorded in $RELEASES"
  docker image inspect "$prev" >/dev/null 2>&1 || die "image of the previous release was pruned: $prev"
  log "rolling back to $(revision "$prev") ($prev)"
  log "note: database migrations are not reversed (restore a pre-deploy backup if needed)"
  cmd_deploy "$prev" </dev/null
}

cmd_status() {
  local cur
  cur=$(current)
  echo "release:  ${cur:-none}"
  [[ -n $cur ]] && echo "revision: $(revision "$cur")"
  if [[ -f $DIR/compose.yaml ]]; then
    compose ps --format '{{.Name}}: {{.Status}}' callsitter
    if running; then control status || true; fi
  fi
}

cmd_drain() {
  lock
  running || die "not running"
  control drain --wait "$DRAIN_WAIT" --ttl $((DRAIN_WAIT + 300))
}

cmd_resume() {
  running || die "not running"
  control resume
}

cmd_backup() {
  install -d -o "$APP_UID" -g "$APP_UID" -m 0750 "$BACKUPS"
  control_backup "nightly-$(date -u +%a).db"
}

# One line to the owner's Telegram chat (TELEGRAM_* in callsitter.env), and to the journal.
notify() {
  local env=/etc/callsitter/callsitter.env token chat
  log "$*"
  token=$(sed -n 's/^TELEGRAM_BOT_TOKEN=//p' "$env" 2>/dev/null | tail -n1 | tr -d "\"'")
  chat=$(sed -n 's/^TELEGRAM_CHAT_ID=//p' "$env" 2>/dev/null | tail -n1 | tr -d "\"'")
  [[ -n $token && -n $chat ]] || return 0
  # The token goes in on stdin rather than the command line, where ps would show it.
  printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$token" |
    curl -fsS -m 20 -o /dev/null -K - --data-urlencode "chat_id=$chat" \
      --data-urlencode "text=VPS maintenance: $*" || log "Telegram notification failed"
}

# HOST_PKGS (and dependencies) with a newer version, as "name old→new" lines.
pending_upgrades() {
  apt-get -s install --only-upgrade "${HOST_PKGS[@]}" 2>/dev/null |
    sed -n 's/^Inst \([^ ]*\) \[\([^]]*\)\] (\([^ ]*\).*/\1 \2→\3/p'
}

active_calls() { control status 2>/dev/null | sed -n 's/.*"activeCalls":\([0-9]*\).*/\1/p'; }

# Waits up to MAINTAIN_WAIT for a moment with no live calls, then takes the lock and drains, so new
# calls are only rejected for the maintenance itself. Exit 75 if that moment never came.
drain_when_idle() {
  local end=$((SECONDS + MAINTAIN_WAIT)) rc
  while ((SECONDS < end)); do
    if [[ $(active_calls) == 0 ]] && try_lock; then
      rc=0
      # A call that started just now still gets 2 minutes to end; otherwise resume and keep waiting.
      control drain --wait 120 --ttl 900 || rc=$?
      ((rc == 0)) && return 0
      ((rc == 75)) || die "drain failed (exit $rc)"
      flock -u 9
    fi
    sleep 30
  done
  return 75
}

cmd_maintain() {
  case ${1:-} in
    "" | --check) ;;
    --after-boot) after_boot; return ;;
    *) die "usage: maintain [--check | --after-boot]" ;;
  esac
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq || die "apt-get update failed"
  # Not local: the EXIT trap reports $summary.
  local upgrades reboot=""
  upgrades=$(pending_upgrades)
  if [[ -f /var/run/reboot-required ]]; then reboot=1; fi
  if [[ -z $upgrades && -z $reboot ]]; then log "nothing to do"; return; fi
  summary="$(paste -sd, - <<<"$upgrades" | sed 's/,/, /g')${reboot:+${upgrades:+; }reboot required}"
  log "pending: $summary"
  [[ ${1:-} == --check ]] && return

  trap 'rc=$?
    if [[ -n $DRAINED ]]; then control resume >/dev/null 2>&1 || true; fi
    ((rc == 0 || rc == 75)) || notify "failed (exit $rc) during: $summary. sudo journalctl -u callsitter-maintain"' EXIT
  if running; then
    log "waiting up to ${MAINTAIN_WAIT}s for no live calls"
    local rc=0
    drain_when_idle || rc=$?
    if ((rc == 75)); then notify "deferred to tomorrow, calls never paused: $summary"; exit 75; fi
    DRAINED=1
  else
    lock
  fi

  if [[ -n $upgrades ]]; then
    log "upgrading ${HOST_PKGS[*]}"
    apt-get install -yq --only-upgrade -o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confold \
      "${HOST_PKGS[@]}"
    if [[ -f /var/run/reboot-required ]]; then reboot=1; fi
  fi

  if [[ -n $reboot ]]; then
    printf '%s\n' "$summary" >"$REBOOT_MARK"
    notify "rebooting after: $summary. A 'back up' message follows once the app is healthy."
    # The drain ends with the container. Resuming now would only let calls start and be cut.
    DRAINED=""
    systemctl reboot
    return
  fi

  # Docker's own upgrade restarts dockerd (live-restore keeps the container); cloudflared's doesn't.
  if grep -q '^cloudflared ' <<<"$upgrades"; then systemctl restart cloudflared; fi
  sleep 5
  systemctl is-active --quiet cloudflared || die "cloudflared isn't running after the upgrade"
  if [[ -n $DRAINED ]]; then
    for _ in {1..30}; do running && break; sleep 2; done
    control resume >/dev/null
    DRAINED=""
  fi
  notify "upgraded $summary; taking calls again"
}

# After a maintenance reboot (callsitter-maintain-boot.service): reports how the host came back.
after_boot() {
  [[ -f $REBOOT_MARK ]] || return 0
  local health="" cid
  for _ in {1..60}; do
    cid=$(compose ps -q callsitter 2>/dev/null || true)
    [[ -n $cid ]] && health=$(docker inspect -f '{{.State.Health.Status}}' "$cid" 2>/dev/null || true)
    [[ $health == healthy ]] && break
    sleep 5
  done
  notify "back up after rebooting for: $(cat "$REBOOT_MARK"). Kernel $(uname -r), app ${health:-not running}, cloudflared $(systemctl is-active cloudflared || true)"
  rm -f "$REBOOT_MARK"
}

case ${1:-} in
  deploy) shift; cmd_deploy "$@" ;;
  rollback) cmd_rollback ;;
  status) cmd_status ;;
  drain) cmd_drain ;;
  resume) cmd_resume ;;
  backup) cmd_backup ;;
  maintain) shift; cmd_maintain "$@" ;;
  *) die "usage: callsitter-deploy deploy <image@sha256:…> | rollback | status | drain | resume | backup | maintain" ;;
esac
