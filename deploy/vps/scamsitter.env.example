# /etc/scamsitter/scamsitter.env (root, 0600): the app's runtime settings and secrets, passed to
# the container by deploy/compose.yaml. Same variables as .env.example; NODE_ENV, BIND_HOST, PORT,
# DATA_DIR and CONFIG_DIR are fixed by the Compose file and ignored here.

PUBLIC_WS_BASE=wss://scamsitter.geekmango.com

TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_SMS_FROM=
TELNYX_MESSAGING_PROFILE_ID=

OPENAI_API_KEY=
TYPESAFE_API_KEY=

OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
TELNYX_SIP_CREDENTIAL_ID=
TELNYX_SIP_CONNECTION_ID=

# New for production: openssl rand -base64 48
MEDIA_TOKEN_SECRET=

OWNER_NUMBER=
OWNER_NAME=
AGENT_LANGUAGES=

ADMIN_AUTH=access
ADMIN_HOST=scamsitter-admin.geekmango.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
