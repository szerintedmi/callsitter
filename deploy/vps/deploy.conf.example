# /etc/scamsitter/deploy.conf: read by bootstrap.sh and scamsitter-deploy (shell syntax).

# Image the deploy key may deploy (the GitHub Actions workflow pushes it by digest).
IMAGE_REPO=ghcr.io/szerintedmi/scamsitter
GHCR_USER=szerintedmi

# Public key of the GitHub Actions deploy key (private half: DEPLOY_SSH_KEY secret).
DEPLOY_PUBKEY=""

# Production tunnel (cloudflared tunnel create …); its credentials JSON goes to
# /etc/cloudflared/<TUNNEL_ID>.json.
TUNNEL_ID=""
HOOKS_HOST=hooks.example.com
ADMIN_HOST=admin.example.com
SSH_HOST=ssh.example.com

# How long a deploy waits for calls to end before giving up (exit 75, nothing changed).
DRAIN_WAIT=900
# Releases whose images stay on disk for rollback, and pre-deploy DB backups kept.
KEEP_RELEASES=5
KEEP_BACKUPS=10
